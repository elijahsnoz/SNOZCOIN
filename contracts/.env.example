# SNOZCOIN Contract Environment Variables
# Copy this to .env and fill in your values

# Stacks Network (testnet or mainnet)
STACKS_NETWORK=testnet

# Your deployer wallet mnemonic (24 words) - KEEP SECRET!
# Get from Hiro Wallet: Settings > Secret Key
DEPLOYER_MNEMONIC=your twenty four word mnemonic phrase goes here keep it secret and safe

# Your STX address (starts with ST for testnet, SP for mainnet)
DEPLOYER_ADDRESS=ST...your_address_here

# Hiro API Key (optional but recommended)
# Get from: https://platform.hiro.so/
HIRO_API_KEY=your_hiro_api_key_here

# Contract name (don't change unless you know what you're doing)
CONTRACT_NAME=snozcoin-profiles
