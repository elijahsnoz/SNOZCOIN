# Get this from @BotFather after running /newbot — see bot/README.md
BOT_TOKEN=

# SNOZ token mint on Solana (defaults to the live mint if unset)
MINT_ADDRESS=Ghy5KXwBbfagjtMx7pTfR7RTfbtTNjuHrVS54q59pump

# Comma-separated Telegram user IDs who can use admin-only commands (/alerts, /unmute)
# even if Telegram's own admin list can't be read (e.g. in DMs). Get your ID from @userinfobot.
BOT_OWNER_IDS=

# --- Moderation ---
# How many strikes before a user is muted
MODERATION_STRIKE_LIMIT=2
# Mute duration in minutes after hitting the strike limit
MODERATION_MUTE_MINUTES=60
# Grace period (seconds) after joining during which a first link post is treated as high-risk
MODERATION_NEW_MEMBER_WINDOW_SECONDS=300

# --- Alerts ---
# Post a price snapshot to enabled chats every N hours (0 disables)
ALERT_DIGEST_INTERVAL_HOURS=6
# Check price every N minutes for big moves (0 disables)
ALERT_MOVE_CHECK_MINUTES=10
# Percent change since last check that triggers a move alert
ALERT_MOVE_THRESHOLD_PERCENT=8
